# ─── Google Firebase ─────────────────────────────────────────────────────────
# Firebase Console → Project Settings → General → Web API Key
FIREBASE_WEB_API_KEY=AIzaSy...

# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=is-presentation-v2
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@is-presentation-v2.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ─── App secrets ─────────────────────────────────────────────────────────────
# Random string for extra HMAC signing (optional, falls back to Firebase)
JWT_SECRET=your-super-secret-string-change-this-in-production

# ─── Gemini AI ───────────────────────────────────────────────────────────────
# Google AI Studio → Get API key → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
